# CCAGENT 环境变量模板
# 首次配置时复制为 .env，再填写需要使用的服务密钥。
# 模板只保留非敏感配置；真实密钥、邮箱地址和授权码仅填写到私有 .env。
# 修改后重启 CCAGENT 生效。请勿用本模板覆盖已经填写好的 .env。
# 默认读取已信任项目的 .env；也可在启动环境或用户 settings.json 的 env 中
# 设置 CCAGENT_ENV_FILE 指向固定文件，不要将该变量写进 .env 本身。
#
# 主模型：使用 /model 选择后可“保存为默认”，后续启动继续使用。
# /model list 查看列表；/model save deepseek 保存默认；启动时可用 --model 覆盖。
# DEEPSEEK_MODEL、QWEN_MODEL、OLLAMA_MODEL 均可填写逗号分隔的多个模型，
# 列表中的第一个模型对应 deepseek、qwen、ollama 别名。
# 这些变量定义可选模型；默认选项由 settings.json 的 defaultModel 管理。

# ── Ollama：本地主模型 ──────────────────────────────────────────────
# 本地服务无需 API Key；使用 openai-chat 协议，地址需要包含 /v1。
# 选择方式：/model ollama 或 ccagent --model ollama。
OLLAMA_PROTOCOL=openai-chat
OLLAMA_MODEL=qwen3.8:27b-mtp-q8_0
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ── DeepSeek：云端文本 / 推理模型 ────────────────────────────────────
# DEEPSEEK_API_KEY 仅从实际选中的 .env 文件加载。
# 选择方式：/model deepseek。
DEEPSEEK_API_KEY=
DEEPSEEK_PROTOCOL=openai-responses
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Qwen：DashScope 连接与主模型列表 ─────────────────────────────────
# 主模型、备用视觉模型及下方音频功能共用 DASHSCOPE_API_KEY。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 按需填写工作空间 ID 或覆盖 Qwen 文本 / 视觉连接配置：
# DASHSCOPE_WORKSPACE_ID=
# QWEN_BASE_URL=
# QWEN_API_KEY=

# /model 中分别显示 Max 和 Flash；/model qwen 默认选择列表中的第一个。
QWEN_PROTOCOL=openai-chat
QWEN_MODEL=qwen3.8-max,qwen3.8-flash

# 图片：仅当当前主模型不支持图片输入时，组合使用此 Omni 模型提取视觉信息，
# 再交给原主模型继续推理；图片附件、Read、Computer Use 和 Rhino 均按此规则路由。
# 多模态主模型直接处理图片，不额外调用 Omni。旧版 qwen-plus 是纯文本模型；
# 云端 qwen3.5-plus / qwen3.6-plus / qwen3.7-plus 和 qwen3.8-max / flash 支持图片输入。
# Ollama 根据 /api/show 的 vision 能力判断，不套用云端同名模型的能力。
# 检测不可用时保守使用备用视觉模型；可通过下方能力覆盖值明确指定。
# 音频：全局内置 read-audio 始终调用此 Omni 模型，不受主模型视觉能力影响。
QWEN_OMNI_MODEL=qwen3.8-omni-flash
# 自定义部署无法自动识别时可覆盖能力：true 支持图片，false 仅文本。
# 不填写则自动识别；对应 settings.json 的 models.<id>.supportsVision 布尔值。
# QWEN_SUPPORTS_VISION=true
# OLLAMA_SUPPORTS_VISION=false

# ── Qwen：音频技能 ──────────────────────────────────────────────────
# 音频读取：上传/粘贴音频文件，或输入 /read-audio @录音.wav。
# 技能随启动安装到 ~/.ccagent/skills/read-audio/SKILL.md，受 /agent-skill 控制。
# /agent-skill list 可单独开启、关闭或删除；删除后不会在启动时自动装回。
# WAV、MP3、AMR、AAC、3GP、3GPP 直接读取；M4A 等尝试转换为 WAV。
# macOS 可使用系统 afconvert，其他平台/格式需要 ffmpeg；原文件及转换结果均不超过 7 MiB。
# Workfriend、clone_sound.skill 与 livetranslate.skill 使用独立的音频模型配置。
# 语音合成模型及默认音色：
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
QWEN_TTS_VOICE=longanhuan_v3.1
# 通常由 DASHSCOPE_BASE_URL 推导 TTS 地址；仅在需要时填写完整端点：
# DASHSCOPE_TTS_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# 实时翻译模型：
QWEN_LIVETRANSLATE_MODEL=qwen3.8-livetranslate-flash-realtime

# ── 联网搜索 ────────────────────────────────────────────────────────
# Tavily 供内置 WebSearch 直接调用，Bocha 可补充搜索或作为指定搜索服务。
# bocha_API_KEY 的大小写需保持如下形式。
TAVILY_API_KEY=
bocha_API_KEY=
# 可选指定 tavily、bocha、api 或 bing；不指定时由应用按可用配置选择。
# WEB_SEARCH_ADAPTER=tavily
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_TIMEOUT_MS=20000
# BOCHA_TIMEOUT_MS=20000

# 古籍检索 classic_words 无需密钥；自定义地址仅支持 cnkgraph.com 的 HTTPS 域名。
# CLASSIC_WORDS_BASE_URL=https://api.cnkgraph.com
# CLASSIC_WORDS_TIMEOUT_MS=15000

# ── Jev：OpenRouter Decisions 决策服务 ──────────────────────────────
# Jev 接收文本 / 结构化状态，负责动作决策与审核；截图由多模态主模型或备用 Omni 识别。
# 启用下方 Jev 功能时，需要配置 OPENROUTER_API_KEY。
OPENROUTER_API_KEY=
JEV_MODEL=~typesafe/jev-latest
# Jev 使用 Decisions 端点；仅在需要时覆盖为官方 openrouter.ai HTTPS 地址。
# JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# JEV_TIMEOUT_MS=8000
# JEV_MIN_CONFIDENCE=0.8

# 功能开关：1 启用，0 关闭。
CCAGENT_COMPUTER_USE_JEV=1
CCAGENT_TOOL_JEV=1
CCAGENT_SEARCH_JEV=1
CCAGENT_WORKFRIEND_JEV=1
CCAGENT_RHINO_JEV=1

# Computer Use：enforce 执行决策，shadow 仅记录，off 关闭。
CCAGENT_JEV_MODE=enforce
# Auto Mode 通用工具审核：enforce、shadow、off。
JEV_TOOL_MODE=enforce
# Workfriend：decision 决定主要动作，advisory 仅评分，off 关闭。
WORKFRIEND_JEV_MODE=decision
# Rhino 单独控制，可在 Computer Use 使用 shadow 时继续执行审核。
CCAGENT_RHINO_JEV_MODE=enforce
# CCAGENT_RHINO_JEV_MIN_CONFIDENCE=0.8

# ── Computer Use：屏幕操作提示 ──────────────────────────────────────
# 从首次 ComputerAction 到该轮任务结束，显示置顶、可穿透点击的提示条和代理指针。
CCAGENT_COMPUTER_USE_INDICATOR=1
# 异常退出时的兜底超时，正常任务结束时自动关闭；范围 30000–600000 毫秒。
# CCAGENT_COMPUTER_USE_INDICATOR_IDLE_TIMEOUT_MS=120000

# ── Rhino：自动化与输出管理 ─────────────────────────────────────────
# rhino_agent 快速调度需要 Jev enforce；0 关闭 RhinoSequence。
# 每个序列最多 15 步，稳定步骤批量预审，动态依赖在解析后审核。
# 所有动作仍经过统一权限检查，Full Mode 跳过普通确认。
CCAGENT_RHINO_FAST=1

# macOS 使用官方 rhinocode 脚本服务，需在 Rhino 8.11+ 中先执行 StartScriptServer。
# Windows 使用 COM；可通过 PROGID 指定已安装的 Rhino 版本。
# CCAGENT_RHINOCODE="/Applications/Rhino 8.app/Contents/Resources/bin/rhinocode"
# CCAGENT_RHINO_INSTANCE=rhinocode_remotepipe_12345
# CCAGENT_RHINO_PROGID=Rhino.Interface.8
# CCAGENT_RHINO_TIMEOUT_MS=60000

# 默认输出：当前用户的 Desktop/CCAGENT-Rhino/<独立任务目录>/。
# 可选指定绝对路径的输出父目录，请使用应用仓库之外的目录。
# CCAGENT_RHINO_OUTPUT_ROOT=/Users/YourName/Desktop/CCAGENT-Rhino
# 继续已有项目时，可指定专用项目目录：
# CCAGENT_RHINO_PROJECT_DIR=/Users/YourName/Desktop/CCAGENT-Rhino/MyTower

# 成功完成后清理本任务的中间截图，保留模型、导出文件、GH 定义、计划及安全快照。
# 设为 0 可保留截图排查问题；已完成的桥接临时文件仍会被清理。
CCAGENT_RHINO_AUTO_CLEANUP=1
# 保留最近 1–20 张预览，以及最终答复引用的全部截图。
CCAGENT_RHINO_KEEP_CAPTURES=1

# ── Google Workspace MCP（可选）────────────────────────────────────
# 运行 ccagent init 并选择安装 Google Workspace 远程 MCP 端点。
# 在 Google Cloud 创建 OAuth 2.0 Web 客户端，登记应用要求的完整回环重定向 URI。
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=
# MCP tools/call 默认超时；服务器的 toolTimeoutMs 配置优先。
# 握手和工具发现仍使用 SDK 的较短超时。
# MCP_TOOL_TIMEOUT_MS=300000

# ── QQ / 163 邮箱（可选）────────────────────────────────────────────
# 在邮箱网页设置中开启 IMAP/SMTP，并生成专用客户端授权码。
# ADDRESS 填写完整邮箱地址；AUTH_CODE 填写授权码，不是邮箱登录密码。
CCAGENT_QQ_MAIL_ADDRESS=
CCAGENT_QQ_MAIL_AUTH_CODE=
CCAGENT_163_MAIL_ADDRESS=
CCAGENT_163_MAIL_AUTH_CODE=
# 在 /powersetting 中分别管理读信、草稿、删信、查信和发信权限。
# 权限保存在用户 settings.json 中，填写邮箱凭据不会自动开启全部权限。

# ── Agent Teams 与运行环境（可选）───────────────────────────────────
# Agent Teams 默认启用，通常通过 /agent-team 管理并保存到用户 settings.json。
# 兼容旧的进程级开关：
# CCAGENT_TEAMS=1

# Bash 路径覆盖；Windows 默认优先使用 Git Bash，避免 WSL 路径转换问题。
# CCAGENT_BASH="C:/Program Files/Git/bin/bash.exe"

# 文档转换运行时；macOS 使用 LibreOffice 渲染 PDF。
# CCAGENT_OFFICE_ENGINE=libreoffice
# CCAGENT_PYTHON=/usr/bin/python3
# CCAGENT_POWERSHELL=C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
# CCAGENT_LIBREOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice
